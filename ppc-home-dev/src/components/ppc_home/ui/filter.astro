---
import FilterSelect from './filter-select.astro';
import { HOME_FEATURED_PROJECTS } from '../../../data/ppc_home/home-featured-projects';
import { withBase } from '../../../utils/paths';

const countries = [...new Set(HOME_FEATURED_PROJECTS.map((item) => item.filter.country))];
const categories = [...new Set(HOME_FEATURED_PROJECTS.flatMap((item) => item.filter.category))];
---

<form class="ui-filter js-ui-filter-form" method="get" action={withBase('collection/')}>
	<div class="ui-filter-body">
		<div class="ui-filter-bar">
			<div class="ui-filter-select-wrap">
				<div class="ui-filter-text">PPC Collection of</div>
				<FilterSelect name="category" options={categories} />
				<div class="ui-filter-text">in</div>
				<FilterSelect name="country" options={countries} />
			</div>

			<button type="submit" class="ui-reset ui-filter-submit">
				<div class="ui-filter-submit-text">Discover</div>
				<div class="ui-filter-submit-icon">
					<svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
						<circle cx="10.5" cy="10.5" r="6.25" stroke="currentColor" stroke-width="1.5" />
						<path d="M15.25 15.25 21 21" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" />
					</svg>
				</div>
			</button>
		</div>
	</div>
</form>
