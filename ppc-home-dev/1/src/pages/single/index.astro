---
import Layout from '../../layouts/Layout.astro';
import { withBase } from '../../utils/paths';

const mediaItems = [
  {
    src: withBase('assets/thumbnails/test-02-portrait.png'),
    width: 1086,
    height: 1448,
    mobile: { cols: 12, span: 8, start: 1, mt: 50 },
    desktop: { cols: 12, span: 5, start: 1, mt: 100 },
  },
  {
    src: withBase('assets/thumbnails/test-03-portrait.png'),
    width: 1086,
    height: 1448,
    mobile: { cols: 12, span: 6, start: 7, mt: 100 },
    desktop: { cols: 10, span: 3, start: 8, mt: -100 },
  },
  {
    src: withBase('assets/thumbnails/test-04-portrait.png'),
    width: 1086,
    height: 1448,
    mobile: { cols: 10, span: 4, start: 2, mt: 74 },
    desktop: { cols: 12, span: 3, start: 4, mt: -150 },
  },
  {
    src: withBase('assets/thumbnails/test-05-landscape.png'),
    width: 1086,
    height: 724,
    mobile: { cols: 12, span: 5, start: 8, mt: 60 },
    desktop: { cols: 11, span: 3, start: 8, mt: 150 },
  },
  {
    src: withBase('assets/thumbnails/test-06-square.png'),
    width: 1086,
    height: 1086,
    mobile: { cols: 12, span: 9, start: 1, mt: 100 },
    desktop: { cols: 12, span: 6, start: 1, mt: 150 },
  },
  {
    src: withBase('assets/thumbnails/test-07-square.png'),
    width: 1086,
    height: 1086,
    mobile: { cols: 12, span: 5, start: 8, mt: 100 },
    desktop: { cols: 10, span: 3, start: 8, mt: -50 },
  },
  {
    src: withBase('assets/thumbnails/test-08-landscape.png'),
    width: 1086,
    height: 724,
    mobile: { cols: 10, span: 4, start: 2, mt: 50 },
    desktop: { cols: 12, span: 3, start: 4, mt: 0 },
  },
  {
    src: withBase('assets/thumbnails/test-09-landscape.png'),
    width: 1672,
    height: 941,
    mobile: { cols: 12, span: 5, start: 8, mt: 60 },
    desktop: { cols: 11, span: 3, start: 8, mt: 150 },
  },
  {
    src: withBase('assets/thumbnails/test-10-square.png'),
    width: 1254,
    height: 1254,
    mobile: { cols: 12, span: 6, start: 1, mt: 50 },
    desktop: { cols: 10, span: 4, start: 1, mt: -100 },
  },
  {
    src: withBase('assets/thumbnails/test-11-landscape.png'),
    width: 1536,
    height: 1024,
    mobile: { cols: 12, span: 9, start: 4, mt: 100 },
    desktop: { cols: 10, span: 4, start: 7, mt: -100 },
  },
  {
    src: withBase('assets/thumbnails/test-12-square.png'),
    width: 1254,
    height: 1254,
    mobile: { cols: 12, span: 7, start: 1, mt: 70 },
    desktop: { cols: 12, span: 4, start: 3, mt: 80 },
  },
];

const scopeItems = [
  { label: 'Brand Direction', src: withBase('assets/thumbnails/test-02-portrait.png'), target: 1 },
  { label: 'Editorial Design', src: withBase('assets/thumbnails/test-05-landscape.png'), target: 4 },
  { label: 'Digital Experience', src: withBase('assets/thumbnails/test-06-square.png'), target: 5 },
  { label: 'Photography', src: withBase('assets/thumbnails/test-10-square.png'), target: 9 },
];
---

<Layout title="Atelier Nord — Studies in Form and Light">
  <main class="single">
    <header class="single__header">
      <h1>( Atelier Nord ) Studies in Form and Light</h1>
    </header>

    <section class="single__featured">
      <figure class="single__thumbnail" data-transition-target>
        <img
          src={withBase('assets/thumbnails/test-01-portrait.png')}
          alt="Studies in Form and Light"
          width="1086"
          height="1448"
        />
      </figure>
    </section>

    <section class="single__project">
      <div class="single__output">
        <p>
          Atelier Nord is a visual identity shaped by material studies, quiet
          typography, and changing light. The project brings print,
          photography, and digital experience into one flexible language.
        </p>
      </div>

      <div class="single__media">
        {
          mediaItems.map(({ src, width, height, mobile, desktop }, index) => (
            <figure
              class="single__media-item"
              id={`media-${index + 1}`}
              style={`--cols:${mobile.cols};--span:${mobile.span};--start:${mobile.start};--mt:${mobile.mt};--lg-cols:${desktop.cols};--lg-span:${desktop.span};--lg-start:${desktop.start};--lg-mt:${desktop.mt};`}
            >
              <img
                src={src}
                alt={`Project study ${index + 1}`}
                width={width}
                height={height}
                loading="lazy"
              />
            </figure>
          ))
        }
      </div>
    </section>

    <article class="single__body">
      <h2>A quiet system for a changing cultural landscape.</h2>
      <p>
        Beginning with material texture and shifting light, the project develops
        a visual language across printed matter and digital space. Its identity
        remains open, changing with the time and place in which it is seen.
      </p>
      <p>
        Space, typography, and photography are organized as a single system,
        allowing each expression to remain flexible while holding a quiet sense
        of continuity.
      </p>
    </article>

    <section class="single__scope">
      <h2>( Deliveries &amp; Scope )</h2>
      <ul>
        {
          scopeItems.map(({ label, src, target }) => (
            <li>
              <a href={`#media-${target}`}>
                <span>{label}</span>
                <img src={src} alt="" width="98" height="68" loading="lazy" />
              </a>
            </li>
          ))
        }
      </ul>
    </section>

    <nav class="single__pagination" aria-label="Project navigation">
      <a href={withBase('')}>← Episode</a>
      <a href={withBase('')}>Next&nbsp;&nbsp;/&nbsp;&nbsp;Another Study</a>
    </nav>
  </main>
</Layout>
